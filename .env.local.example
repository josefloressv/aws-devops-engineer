# Copy to .env.local (untracked) and fill in. Sourced by scripts/lib.sh.
#
# Only the ops/ and cost tooling needs these -- lab and base stacks deploy with
# whatever credentials are ambient and ignore everything here.

# Organization payer (management) account. Credits pool at this account and only
# its Cost Explorer sees org-wide data, so scripts/credit-burn-check.sh and
# scripts/ops-apply.sh refuse to run anywhere else.
PAYER_ACCOUNT_ID=123456789012

# Profile used to reach that account when AWS_PROFILE is not already set.
PAYER_PROFILE_DEFAULT=my-payer-profile.AdministratorAccess
